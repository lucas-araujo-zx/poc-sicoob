# Opcional. Se vazio, a bancada usa o mesmo token da Viveo
# (VIVEO_LOGIN_TOKEN, ALMAVIVA_LOGIN_TOKEN ou ICATU_LOGIN_TOKEN).
SICOOB_LOGIN_TOKEN=

# Opcional. Se vazio, usa a chave do workspace da Viveo (icatu/lab).
ELEVENLABS_API_KEY=

# Ciro. Se vazio, a bancada usa o agente Sicoob - Ciro - Cobrança.
SICOOB_VOICE_AGENT=

# Opcional. Se vazio, usa o discador já compartilhado pelos demos de saída.
SICOOB_DIALER_ID=

# Opcional. Se vazios, o servidor lê ATENDESIMPLES_* de demos/demos-frontend.
ATENDESIMPLES_API_KEY=
ATENDESIMPLES_DIALER_TOKEN=
ATENDESIMPLES_BASE_URL=
ATENDESIMPLES_DRY_RUN=
